[Unit]
Description=XingfaCAD (FastAPI + React)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Sua User / WorkingDirectory theo may
User=xingfa
Group=xingfa
WorkingDirectory=/opt/xingfacad
EnvironmentFile=-/opt/xingfacad/.env
ExecStart=/opt/xingfacad/.venv/bin/python -m xingfacad serve --host 0.0.0.0 --port 8010
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
